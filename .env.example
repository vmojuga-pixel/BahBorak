# .env.example

# WhatsApp (or other provider) API endpoint to send messages (POST)
# Example (for a placeholder service): https://api.whatsapp.example/send
WHATSAPP_API_URL=
# Bearer token used to authenticate outbound HTTP calls to WhatsApp provider
WHATSAPP_API_TOKEN=
# Verification token used for webhook verification (hub.verify_token)
WHATSAPP_VERIFY_TOKEN=
# Internal token to authorize dispatch cron/manual calls
INTERNAL_DISPATCH_TOKEN=

# Cloudflare bindings are set in wrangler.toml and cloudflare secrets
# DB/KV/R2 bindings: DB, KV, AUDIT
